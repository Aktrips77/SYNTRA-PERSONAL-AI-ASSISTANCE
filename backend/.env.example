# --- SYNTRA backend configuration ---

# Required. Get one from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Required. Any model slug available on OpenRouter, e.g. openai/gpt-4o-mini,
# anthropic/claude-3.5-sonnet, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Shown to OpenRouter for its analytics/rankings, not required to work.
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_SITE_NAME=SYNTRA

# Optional. Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Request timeout (seconds) for the OpenRouter call.
AI_REQUEST_TIMEOUT=30
